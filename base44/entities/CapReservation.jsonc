{
  "name": "CapReservation",
  "type": "object",
  "properties": {
    "idempotency_key": {
      "type": "string",
      "description": "Idempotency key for the reservation attempt"
    },
    "lead_id": {
      "type": "string",
      "description": "Lead the reservation is held for"
    },
    "route_member_id": {
      "type": "string",
      "description": "RouteMember whose cap is being reserved"
    },
    "price": {
      "type": "number",
      "description": "Price locked in at reservation time"
    },
    "state": {
      "type": "string",
      "enum": [
        "reserved",
        "finalized",
        "released"
      ],
      "default": "reserved"
    },
    "wallet_txn_id": {
      "type": "string",
      "description": "Wallet transaction id when finalized"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "idempotency_key",
    "route_member_id"
  ]
}
