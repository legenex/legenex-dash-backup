{
  "name": "ErrorLog",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Reference to Lead record, nullable"
    },
    "stage": {
      "type": "string",
      "enum": [
        "auth",
        "validation",
        "mapping",
        "hlr",
        "leadbyte",
        "system"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "warning",
        "error",
        "critical"
      ],
      "default": "error"
    },
    "message": {
      "type": "string"
    },
    "detail": {
      "type": "string",
      "description": "JSON string with full error details"
    },
    "supplier_name": {
      "type": "string"
    },
    "resolved": {
      "type": "boolean",
      "default": false
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "stage",
    "severity",
    "message"
  ]
}
