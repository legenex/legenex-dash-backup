{
  "name": "BuyerWallet",
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string",
      "description": "Reference to the Buyer record"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Authoritative current wallet balance"
    },
    "version": {
      "type": "number",
      "default": 0,
      "description": "CAS version, incremented on every balance change"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "buyer_id"
  ]
}
