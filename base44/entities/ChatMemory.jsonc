{
  "name": "ChatMemory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User this memory belongs to"
    },
    "fact": {
      "type": "string",
      "description": "A concise learned fact or preference extracted from conversation, e.g. 'User prefers revenue figures net of IPL fees' or 'User's top buyer is LeadFlow'"
    },
    "category": {
      "type": "string",
      "enum": [
        "preference",
        "business_rule",
        "data_insight",
        "definition",
        "other"
      ],
      "default": "other",
      "description": "What kind of memory this is"
    },
    "source_conversation_id": {
      "type": "string",
      "description": "Conversation this memory was learned from. Nullable."
    },
    "confidence": {
      "type": "number",
      "default": 1,
      "description": "How confident the bot is in this memory, 1-5"
    },
    "times_referenced": {
      "type": "number",
      "default": 0,
      "description": "How many times this memory has been used as context"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "False when the user dismisses or corrects this memory"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "user_id",
    "fact"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
