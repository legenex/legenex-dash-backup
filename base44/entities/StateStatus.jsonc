{
  "name": "StateStatus",
  "type": "object",
  "properties": {
    "vertical": {
      "type": "string",
      "description": "The vertical code"
    },
    "state": {
      "type": "string",
      "description": "Two letter US state code, uppercase"
    },
    "active": {
      "type": "boolean",
      "default": false,
      "description": "True when at least one active buyer covers this state"
    },
    "effective_client_type": {
      "type": "string",
      "enum": [
        "Law Firm",
        "Aggregator",
        "Reseller",
        "Network"
      ],
      "description": "The winning coverage tier for this state. Nullable."
    },
    "highest_cpl": {
      "type": "number",
      "default": 0
    },
    "lowest_cpl": {
      "type": "number",
      "default": 0
    },
    "active_buyer_count": {
      "type": "number",
      "default": 0
    },
    "last_changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this state status last changed. Nullable."
    },
    "last_change_direction": {
      "type": "string",
      "enum": [
        "opened",
        "closed",
        "repriced"
      ],
      "description": "Direction of the last change. Nullable."
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "vertical",
    "state"
  ],
  "unique": [
    [
      "vertical",
      "state"
    ]
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
