{
  "name": "FieldMapping",
  "type": "object",
  "properties": {
    "source_field": {
      "type": "string",
      "description": "Inbound payload key"
    },
    "target_field": {
      "type": "string",
      "description": "Normalized lead field the source key maps to"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "source_field",
    "target_field"
  ]
}
