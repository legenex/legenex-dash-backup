{
  "name": "IntegrationConfig",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Integration key e.g. whatsapp"
    },
    "config": {
      "type": "string",
      "description": "JSON string of credentials/settings for this integration"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "name"
  ]
}
