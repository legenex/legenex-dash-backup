{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Friendly label for this key"
    },
    "type": {
      "type": "string",
      "enum": [
        "master",
        "supplier"
      ],
      "default": "supplier",
      "description": "master keys have no linked supplier; supplier keys link to exactly one supplier"
    },
    "supplier_name": {
      "type": "string",
      "description": "Supplier display name (denormalized for fast lookup)"
    },
    "supplier_id": {
      "type": "string",
      "description": "Reference to Supplier record (optional for master keys)"
    },
    "vertical": {
      "type": "string",
      "description": "Optional vertical code this key is used for"
    },
    "key": {
      "type": "string",
      "description": "Full key value \u2014 only present at creation; should be hashed in production"
    },
    "key_prefix": {
      "type": "string",
      "description": "First 16 chars of key, shown in UI"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_count": {
      "type": "number",
      "default": 0
    },
    "allowed_ips": {
      "type": "string",
      "description": "JSON array of allowed IP addresses, optional"
    },
    "expose_revenue": {
      "type": "boolean",
      "default": false,
      "description": "When true, supplier responses may include revenue"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "name",
    "key",
    "key_prefix"
  ]
}
