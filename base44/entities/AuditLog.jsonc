{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Reference to Lead record"
    },
    "lead_match_key": {
      "type": "string",
      "description": "Normalized email or phone used for the backup lookup"
    },
    "recovered_cert_url": {
      "type": "string",
      "description": "The cert URL recovered from CertBackupStore, unchanged"
    },
    "original_session_timestamp": {
      "type": "string",
      "description": "Copied from the stored CertBackupStore row, never recomputed"
    },
    "cert_source": {
      "type": "string",
      "default": "backup_store"
    },
    "backfilled_at": {
      "type": "string",
      "format": "date-time"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "lead_id",
    "recovered_cert_url"
  ]
}
