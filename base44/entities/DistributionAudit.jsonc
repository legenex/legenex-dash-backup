{
  "name": "DistributionAudit",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "e.g. publish, pause, archive, rollback, mode_change"
    },
    "entity_type": {
      "type": "string",
      "description": "RouteGroup | AppSettings"
    },
    "entity_id": {
      "type": "string"
    },
    "from_value": {
      "type": "string"
    },
    "to_value": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "actor_id": {
      "type": "string",
      "description": "Operator user id who performed the action"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "action",
    "actor_id"
  ]
}
