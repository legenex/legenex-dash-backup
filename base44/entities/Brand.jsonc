{
  "name": "Brand",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string",
      "description": "Display name of the brand"
    },
    "brand_code": {
      "type": "string",
      "description": "Short code e.g. CAC = Check A Case, CMC = Check My Claim"
    },
    "website_url": {
      "type": "string",
      "description": "Brand website URL"
    },
    "optin_url": {
      "type": "string",
      "description": "Default optin/landing page URL for this brand"
    },
    "supplier_names": {
      "type": "string",
      "description": "JSON array of Supplier names linked to this brand"
    },
    "facebook_pages": {
      "type": "string",
      "description": "JSON array of linked Facebook Page names/ids for additional metrics"
    },
    "instagram_accounts": {
      "type": "string",
      "description": "JSON array of linked Instagram account handles for additional metrics"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "brand_name",
    "brand_code"
  ]
}
