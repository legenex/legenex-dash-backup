{
  "name": "ReferenceKey",
  "type": "object",
  "properties": {
    "field_name": {
      "type": "string",
      "description": "Token name e.g. injury_type"
    },
    "label": {
      "type": "string",
      "description": "Display label e.g. Injury Type"
    },
    "values": {
      "type": "string",
      "description": "JSON array of possible values for this field"
    },
    "note": {
      "type": "string",
      "description": "Optional note e.g. Primary input field"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "field_name",
    "values"
  ]
}
