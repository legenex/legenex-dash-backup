{
  "name": "ContractVersion",
  "properties": {
    "campaign_id": {
      "description": "Campaign record id this snapshot belongs to.",
      "type": "string"
    },
    "campaign_name": {
      "description": "Denormalized campaign name at time of publish.",
      "type": "string"
    },
    "change_summary": {
      "description": "Human readable note on what changed from the previous version.",
      "type": "string"
    },
    "content_hash": {
      "description": "SHA256 of contract_json. Used as the ETag on /functions/contract.",
      "type": "string"
    },
    "contract_json": {
      "description": "Full serialized intake contract as published.",
      "type": "string"
    },
    "is_current": {
      "default": true,
      "description": "True for the latest published version of a campaign.",
      "type": "boolean"
    },
    "published_by": {
      "description": "Email of the user who published this version.",
      "type": "string"
    },
    "version": {
      "description": "Contract version number captured at publish time.",
      "type": "number"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "campaign_id",
    "version",
    "contract_json"
  ],
  "type": "object"
}
