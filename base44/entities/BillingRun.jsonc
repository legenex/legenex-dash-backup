{
  "name": "BillingRun",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "buyer",
        "supplier"
      ],
      "description": "Whether this run bills a buyer or a supplier. Exactly one of buyer_id or supplier_id must be set, matching scope."
    },
    "buyer_id": {
      "type": "string",
      "description": "Reference to a Buyer record. Set when scope is buyer. Nullable."
    },
    "supplier_id": {
      "type": "string",
      "description": "Reference to a Supplier record. Set when scope is supplier. Nullable."
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the billing period."
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "End of the billing period."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "paid",
        "void"
      ],
      "default": "draft"
    },
    "total_leads": {
      "type": "number",
      "default": 0
    },
    "billable_leads": {
      "type": "number",
      "default": 0,
      "description": "Total leads minus accepted returns."
    },
    "returns": {
      "type": "number",
      "default": 0
    },
    "gross": {
      "type": "number",
      "default": 0
    },
    "ipl_fees": {
      "type": "number",
      "default": 0
    },
    "net": {
      "type": "number",
      "default": 0
    },
    "invoice_id": {
      "type": "string",
      "description": "Reference to the existing Invoice record created from this run. Nullable."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this run was generated. Nullable."
    },
    "generated_by": {
      "type": "string",
      "description": "User id who generated this run. Nullable."
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "scope",
    "period_start",
    "period_end"
  ],
  "unique": [
    [
      "scope",
      "buyer_id",
      "supplier_id",
      "period_start",
      "period_end"
    ]
  ]
}
