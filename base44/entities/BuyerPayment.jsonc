{
  "name": "BuyerPayment",
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string",
      "description": "Optional reference to the Invoice this payment settles"
    },
    "amount": {
      "type": "number"
    },
    "method": {
      "type": "string",
      "enum": [
        "manual",
        "csv",
        "stripe",
        "bank"
      ],
      "default": "manual"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "buyer_name",
    "amount"
  ]
}
