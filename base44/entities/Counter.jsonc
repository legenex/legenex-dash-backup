{
  "name": "Counter",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique name identifying the counter sequence (e.g. lead_id)"
    },
    "value": {
      "type": "number",
      "default": 0,
      "description": "Current value of the counter"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the counter was last incremented"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "name",
    "value"
  ]
}