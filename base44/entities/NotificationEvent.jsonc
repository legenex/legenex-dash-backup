{
  "name": "NotificationEvent",
  "type": "object",
  "properties": {
    "rule_id": {
      "type": "string",
      "description": "Reference to NotificationRule"
    },
    "triggered_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "delivered": {
      "type": "boolean",
      "default": false
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "rule_id",
    "summary"
  ]
}
