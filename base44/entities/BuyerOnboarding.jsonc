{
  "name": "BuyerOnboarding",
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string",
      "description": "Reference to a Buyer record. Null until a Buyer is created from the submission. Nullable."
    },
    "company_name": {
      "type": "string",
      "description": "Company name captured on the submission before a Buyer exists."
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "in_progress",
        "blocked",
        "complete",
        "cancelled"
      ],
      "default": "submitted",
      "description": "Onboarding lifecycle status."
    },
    "form_payload": {
      "type": "string",
      "description": "JSON object holding the complete raw submission, including free text answers not promoted to Buyer fields, such as prior lead generation experience, that experience described, and additional requirements."
    },
    "steps": {
      "type": "string",
      "description": "JSON array of step objects. Each step has key, status (pending, running, complete, failed, skipped), attempts, error, external_id and completed_at. The external_id records what was already created on the remote system so a retry is safe."
    },
    "current_step": {
      "type": "string",
      "description": "Key of the step currently being processed. Nullable."
    },
    "intro_email_scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "When the intro email is scheduled to send. Nullable."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the submission was received. Nullable."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When onboarding completed. Nullable."
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "token": {
      "type": "string",
      "description": "Onboarding link token. Present on records in the primary app but never declared in its schema; declared here so the mirror can hold the value."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
