{
  "description": "Operator-tagged metadata for a Meta ad creative. Joined to AdSpend ad-level rows by ad_id. Hook, concept and creator are not exposed by the Meta API, so they are tagged here and drive the Creative Analyzer rollups.",
  "name": "AdCreativeMeta",
  "properties": {
    "active": {
      "default": true,
      "type": "boolean"
    },
    "ad_account_id": {
      "type": "string"
    },
    "ad_id": {
      "description": "Meta ad id. Join key to AdSpend rows where level = ad.",
      "type": "string"
    },
    "ad_name": {
      "description": "Meta ad name at time of tagging, for display when spend rows are outside the window.",
      "type": "string"
    },
    "concept": {
      "description": "Creative concept, for example ER Waiting Room.",
      "type": "string"
    },
    "creative_type": {
      "default": "video",
      "enum": [
        "video",
        "image",
        "carousel",
        "other"
      ],
      "type": "string"
    },
    "creator": {
      "description": "Creator or production source, for example a UGC creator name or Studio.",
      "type": "string"
    },
    "hook": {
      "description": "Opening hook line used in the creative.",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "platform": {
      "default": "meta",
      "type": "string"
    },
    "utm_content": {
      "description": "Optional utm_content value this ad passes to the funnel, used to join verified lead outcomes back to the creative.",
      "type": "string"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "ad_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}
