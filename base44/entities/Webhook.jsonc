{
  "name": "Webhook",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "secret": {
      "type": "string"
    },
    "events": {
      "type": "string",
      "description": "JSON array of event names e.g. [\"lead.sold\",\"lead.unsold\"]"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "headers": {
      "type": "string",
      "description": "JSON object of custom headers"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "name",
    "url"
  ]
}
