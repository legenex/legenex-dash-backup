{
  "name": "DestinationHealth",
  "type": "object",
  "properties": {
    "sub_delivery_id": {
      "type": "string",
      "description": "CANONICAL endpoint this health record tracks. The circuit breaker is per endpoint (sub-delivery), not per buyer."
    },
    "destination_id": {
      "type": "string",
      "description": "DEPRECATED (compatibility only): legacy destination id. Superseded by sub_delivery_id."
    },
    "consecutive_failures": {
      "type": "number",
      "default": 0,
      "description": "Consecutive failures since last success"
    },
    "success_rate": {
      "type": "number",
      "description": "Rolling success rate (0-1)"
    },
    "state": {
      "type": "string",
      "enum": [
        "closed",
        "open",
        "half_open"
      ],
      "default": "closed"
    },
    "disabled_until": {
      "type": "string",
      "format": "date-time",
      "description": "When the breaker allows traffic again"
    },
    "last_success_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_failure_at": {
      "type": "string",
      "format": "date-time"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "destination_id"
  ]
}
