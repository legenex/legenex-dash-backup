{
  "name": "KnowledgeDoc",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Display title of the knowledge item"
    },
    "kind": {
      "type": "string",
      "enum": [
        "doc",
        "note",
        "glossary",
        "template"
      ],
      "default": "doc",
      "description": "doc = reference document, note = free-form note, glossary = term/definition, template = disposition/feedback template"
    },
    "term": {
      "type": "string",
      "description": "For glossary items: the term being defined"
    },
    "content": {
      "type": "string",
      "description": "Body text / definition / template content that the bots read as context"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "When true, bots include this item in their context"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "file_url": {
      "type": "string",
      "description": "URL of an uploaded source file (image, doc, spreadsheet). Nullable."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "file_upload",
        "json_upload",
        "ai_generated"
      ],
      "default": "manual",
      "description": "How this knowledge item was created"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "title"
  ]
}
