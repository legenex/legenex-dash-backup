{
  "name": "RouteConfigVersion",
  "type": "object",
  "properties": {
    "route_group_id": {
      "type": "string",
      "description": "The RouteGroup this version was published from"
    },
    "campaign_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Monotonic version number per group"
    },
    "config_hash": {
      "type": "string",
      "description": "Content hash; matches RouteDecisionTrace.config_version"
    },
    "snapshot": {
      "type": "string",
      "description": "JSON immutable snapshot of the group + members (non-secret)"
    },
    "published_by": {
      "type": "string",
      "description": "Operator user id who published"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "change_reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "archived"
      ],
      "default": "published"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "route_group_id",
    "config_hash"
  ]
}
