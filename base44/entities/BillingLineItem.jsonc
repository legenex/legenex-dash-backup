{
  "name": "BillingLineItem",
  "type": "object",
  "properties": {
    "billing_run_id": {
      "type": "string",
      "description": "Reference to a BillingRun record."
    },
    "vertical": {
      "type": "string",
      "description": "Vertical code for this line. Nullable."
    },
    "state": {
      "type": "string",
      "description": "Two letter US state code for this line. Nullable."
    },
    "campaign_id": {
      "type": "string",
      "description": "Reference to a Campaign record. Nullable."
    },
    "supplier_id": {
      "type": "string",
      "description": "Present on buyer runs to show which supplier the leads came from. Nullable."
    },
    "source_code": {
      "type": "string",
      "description": "Present on supplier runs to attribute a line to a SupplierSource. Nullable."
    },
    "lead_count": {
      "type": "number",
      "default": 0
    },
    "returns": {
      "type": "number",
      "default": 0
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string",
      "description": "Human readable description of this line. Nullable."
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "billing_run_id"
  ]
}
