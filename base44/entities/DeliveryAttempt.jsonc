{
  "name": "DeliveryAttempt",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Lead being delivered"
    },
    "sub_delivery_id": {
      "type": "string",
      "description": "CANONICAL endpoint the attempt targets. Retries and health/circuit-breaker key on this so they are per endpoint, not per buyer."
    },
    "destination_id": {
      "type": "string",
      "description": "DEPRECATED (compatibility only): legacy destination id. Superseded by sub_delivery_id."
    },
    "trigger": {
      "type": "string",
      "description": "What triggered this attempt (e.g. route, retry, manual)"
    },
    "attempt_number": {
      "type": "number",
      "default": 1,
      "description": "Sequential attempt number for this lead+destination"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Idempotency key for the outbound delivery"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "accepted",
        "rejected",
        "duplicate",
        "queued",
        "error",
        "dead_letter"
      ],
      "default": "pending"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the primary/winning delivery"
    },
    "request_meta": {
      "type": "string",
      "description": "JSON, secrets redacted"
    },
    "response_meta": {
      "type": "string",
      "description": "JSON, PII minimized"
    },
    "http_status": {
      "type": "number",
      "description": "HTTP status code of the delivery response"
    },
    "latency_ms": {
      "type": "number",
      "description": "Round-trip latency in milliseconds"
    },
    "error_class": {
      "type": "string",
      "description": "Classified error type when the attempt fails"
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the retry worker should next attempt"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "lead_id",
    "destination_id"
  ]
}
