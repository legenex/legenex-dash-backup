{
  "name": "BuyerStateCpl",
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string",
      "description": "Reference to a Buyer record"
    },
    "vertical": {
      "type": "string",
      "description": "The vertical code this pricing applies to"
    },
    "state": {
      "type": "string",
      "description": "Two letter US state code, uppercase"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this buyer is currently accepting leads in this state"
    },
    "cpl": {
      "type": "number",
      "description": "The cost per lead this buyer pays in this state"
    },
    "ipl": {
      "type": "number",
      "description": "Computed as cpl multiplied by the buyer's ipl_fee_pct at write time"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this state pricing was paused. Nullable."
    },
    "paused_reason": {
      "type": "string",
      "description": "Reason this state pricing was paused. Nullable."
    },
    "paused_by": {
      "type": "string",
      "description": "The user id who paused it. Nullable."
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "buyer_id",
    "vertical",
    "state",
    "cpl"
  ],
  "unique": [
    [
      "buyer_id",
      "vertical",
      "state"
    ]
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
