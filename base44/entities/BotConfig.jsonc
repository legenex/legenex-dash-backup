{
  "name": "BotConfig",
  "type": "object",
  "properties": {
    "bot_key": {
      "type": "string",
      "enum": [
        "data",
        "build"
      ],
      "description": "Which bot this config is for"
    },
    "name": {
      "type": "string",
      "default": "DataBot",
      "description": "Display name"
    },
    "tagline": {
      "type": "string",
      "description": "Short description shown under the bot name"
    },
    "avatar_url": {
      "type": "string",
      "description": "Avatar image URL. Nullable."
    },
    "greeting": {
      "type": "string",
      "description": "Welcome message shown when the bot starts"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master enable for this bot"
    },
    "auto_open_seconds": {
      "type": "number",
      "default": 0,
      "description": "Auto-open the bot after N seconds. 0 = never."
    },
    "escalate_after_turns": {
      "type": "number",
      "default": 6,
      "description": "Number of user turns before suggesting escalation"
    },
    "max_messages_per_session": {
      "type": "number",
      "default": 30
    },
    "log_transcripts": {
      "type": "boolean",
      "default": true,
      "description": "Log full transcripts for KB improvement"
    },
    "model": {
      "type": "string",
      "default": "gpt-4o-mini",
      "description": "OpenAI model used by this bot"
    },
    "temperature": {
      "type": "number",
      "default": 0.4
    },
    "max_tokens": {
      "type": "number",
      "default": 600
    },
    "instructions": {
      "type": "string",
      "description": "Full system instructions for the bot"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "bot_key"
  ],
  "unique": [
    [
      "bot_key"
    ]
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
