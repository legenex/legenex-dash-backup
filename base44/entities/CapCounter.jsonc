{
  "name": "CapCounter",
  "type": "object",
  "properties": {
    "scope_key": {
      "type": "string",
      "description": "Single canonical key (e.g. buyer:B1:daily:2026-07-13). Primary CAS lookup."
    },
    "count": {
      "type": "number",
      "default": 0,
      "description": "Consumed count within the current window"
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "buyer",
        "route_member",
        "campaign",
        "state",
        "supplier",
        "claim"
      ],
      "description": "Dimension the cap applies to (reporting)"
    },
    "scope_id": {
      "type": "string",
      "description": "Id of the scoped entity (reporting)"
    },
    "window": {
      "type": "string",
      "enum": [
        "total",
        "hourly",
        "daily",
        "weekly",
        "monthly",
        "claim"
      ],
      "description": "Time window the counter aggregates over (reporting)"
    },
    "window_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the current window bucket (reporting)"
    },
    "limit": {
      "type": "number",
      "description": "Cap limit for this window (reporting)"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "scope_key"
  ]
}
