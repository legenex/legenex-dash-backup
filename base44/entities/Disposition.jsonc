{
  "name": "Disposition",
  "type": "object",
  "properties": {
    "value": {
      "type": "string",
      "description": "Canonical disposition name in our taxonomy"
    },
    "description": {
      "type": "string",
      "description": "Short description of what this disposition means"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "value"
  ]
}
