{
  "name": "Campaign",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "description": "Additive. Short, operator-facing public code suppliers post as campaign_id to target this campaign (e.g. MVA, WC). Matched case-insensitively during campaign resolution, ahead of the vertical fallback. Distinct from the internal record id."
    },
    "name": {
      "type": "string",
      "description": "Campaign display name. A campaign IS a vertical: the campaign name defines the vertical."
    },
    "vertical": {
      "type": "string",
      "description": "Vertical code this campaign belongs to. A campaign is a vertical, so this mirrors the campaign identity."
    },
    "brand": {
      "type": "string",
      "description": "Brand code / name this campaign is associated with. Nullable."
    },
    "send_mode": {
      "type": "string",
      "enum": [
        "ping_post",
        "direct_post",
        "both"
      ],
      "default": "direct_post",
      "description": "How sources send leads into this campaign: Ping Post, Direct Post, or Both. Not a forced either/or."
    },
    "supplier_ids": {
      "type": "string",
      "description": "JSON array of Supplier record ids assigned to this campaign"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ],
      "default": "active",
      "description": "Campaign lifecycle status. Kept in sync with the active boolean: active derives active true, disabled derives active false."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "name"
  ]
}
