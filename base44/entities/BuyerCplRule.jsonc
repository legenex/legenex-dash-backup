{
  "name": "BuyerCplRule",
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string",
      "description": "Reference to the Buyer record this rule belongs to"
    },
    "name": {
      "type": "string",
      "description": "Optional label for the rule"
    },
    "vertical": {
      "type": "string",
      "description": "Optional vertical code the rule applies to"
    },
    "campaign_id": {
      "type": "string",
      "description": "Optional reference to a Campaign record the rule applies to"
    },
    "conditions": {
      "type": "string",
      "description": "JSON array of {field, operator, value} conditions using the exact same shape and operators as LeadByteConnector field conditions, so the Buyers CPL editor can reuse the existing field condition builder component"
    },
    "cpl": {
      "type": "number",
      "description": "The price paid when the conditions match"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "Evaluation order when multiple rules match, higher priority wins"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "buyer_id",
    "cpl"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
