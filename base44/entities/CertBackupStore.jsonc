{
  "name": "CertBackupStore",
  "type": "object",
  "properties": {
    "lead_match_key": {
      "type": "string",
      "description": "Normalized email (lowercase, trimmed) or phone (digits only) for lookup"
    },
    "trustedform_url": {
      "type": "string",
      "description": "Exact cert string as captured at the LeadShook page, never modified"
    },
    "original_session_timestamp": {
      "type": "string",
      "description": "Captured client-side the moment xxTrustedFormCertUrl populated; copied verbatim, never server-generated"
    },
    "optin_url": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "client_ip": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "default": "leadshook_frontend"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server receive time, separate from session timestamp"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "lead_match_key",
    "trustedform_url"
  ]
}
