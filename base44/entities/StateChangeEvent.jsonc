{
  "name": "StateChangeEvent",
  "type": "object",
  "properties": {
    "vertical": {
      "type": "string",
      "description": "The vertical code"
    },
    "state": {
      "type": "string",
      "description": "Two letter US state code, uppercase"
    },
    "direction": {
      "type": "string",
      "enum": [
        "opened",
        "closed",
        "repriced"
      ],
      "description": "Direction of this state change"
    },
    "old_client_type": {
      "type": "string",
      "description": "Previous effective client type. Nullable."
    },
    "new_client_type": {
      "type": "string",
      "description": "New effective client type. Nullable."
    },
    "old_cpl": {
      "type": "number",
      "description": "Previous CPL. Nullable."
    },
    "new_cpl": {
      "type": "number",
      "description": "New CPL. Nullable."
    },
    "triggered_by_buyer_id": {
      "type": "string",
      "description": "Buyer record id that triggered this change. Nullable."
    },
    "triggered_by_user_id": {
      "type": "string",
      "description": "User record id that triggered this change. Nullable."
    },
    "notified_supplier_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Supplier record ids successfully reached on at least one channel for this event"
    },
    "notification_status": {
      "type": "object",
      "description": "Per channel delivery outcome, shaped as {email: {sent, failed, errors}, slack: {...}, whatsapp: {...}}. Nullable.",
      "properties": {
        "email": {
          "type": "object",
          "properties": {
            "sent": {
              "type": "number"
            },
            "failed": {
              "type": "number"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "slack": {
          "type": "object",
          "properties": {
            "sent": {
              "type": "number"
            },
            "failed": {
              "type": "number"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "whatsapp": {
          "type": "object",
          "properties": {
            "sent": {
              "type": "number"
            },
            "failed": {
              "type": "number"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this event was included in a digest. Null means not yet notified."
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "vertical",
    "state",
    "direction"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
