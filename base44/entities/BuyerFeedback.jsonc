{
  "name": "BuyerFeedback",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Reference to the Lead record this feedback is about (nullable if no lead matched)"
    },
    "buyer_id": {
      "type": "string",
      "description": "Reference to the Buyer record that submitted this feedback"
    },
    "matched_by": {
      "type": "string",
      "enum": [
        "",
        "phone",
        "email",
        "manual"
      ],
      "default": "",
      "description": "How the lead was matched: phone, email, or manual (added in portal)"
    },
    "disposition": {
      "type": "string",
      "description": "Mapped disposition from our taxonomy (e.g. Converted, Wrong Number)"
    },
    "raw_disposition": {
      "type": "string",
      "description": "The buyer's own free text or code before AI mapping"
    },
    "notes": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "description": "Short outcome summary provided by the buyer"
    },
    "revenue_value": {
      "type": "number",
      "default": 0,
      "description": "Revenue value the buyer attributes to this lead, if any"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "webhook"
      ],
      "default": "manual",
      "description": "manual = added in the portal, webhook = posted to the feedback endpoint"
    },
    "match_confidence": {
      "type": "number",
      "default": 1,
      "description": "AI mapping confidence 0-1 for the raw->taxonomy disposition mapping"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "buyer_id",
    "disposition"
  ]
}
