{
  "name": "CustomCalculation",
  "type": "object",
  "properties": {
    "output_token": {
      "type": "string",
      "description": "e.g. accident_date"
    },
    "output_label": {
      "type": "string"
    },
    "transform_type": {
      "type": "string",
      "enum": [
        "date_age_bucket",
        "value_map",
        "clone",
        "script"
      ],
      "default": "date_age_bucket"
    },
    "vertical": {
      "type": "string",
      "description": "Vertical code this calculation applies to. Empty means it applies to all verticals."
    },
    "input_field": {
      "type": "string",
      "description": "Token name of the input field"
    },
    "config": {
      "type": "string",
      "description": "JSON string of transform config (buckets, map, script)"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "output_token",
    "transform_type"
  ]
}
