{
  "name": "ReturnRequest",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Reference to the Lead record being returned"
    },
    "buyer_id": {
      "type": "string",
      "description": "Reference to the Buyer record requesting the return"
    },
    "reason": {
      "type": "string",
      "description": "Buyer's reason for the return request"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "approved",
        "rejected"
      ],
      "default": "requested"
    },
    "requested_date": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_date": {
      "type": "string",
      "format": "date-time"
    },
    "resolver_notes": {
      "type": "string",
      "description": "Operator notes when approving or rejecting"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "buyer_id",
    "reason"
  ]
}
