{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string",
      "description": "Reference to Buyer record"
    },
    "type": {
      "type": "string",
      "enum": [
        "credit",
        "debit",
        "recharge",
        "adjustment"
      ],
      "default": "credit"
    },
    "amount": {
      "type": "number"
    },
    "balance_after": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Additive. Dedupe key so a debit/credit applies at most once (native ledger)"
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "rejected"
      ],
      "description": "Additive. applied = balance moved; rejected = insufficient/over-limit, no balance change"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Backup mirror only. The created_date this record has in the primary Legenex dashboard app. Base44 stamps its own created_date on insert, so this column carries the real event time and the app's read layer substitutes it for created_date."
    }
  },
  "required": [
    "buyer_id",
    "type",
    "amount"
  ]
}
