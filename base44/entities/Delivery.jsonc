{
  "name": "Delivery",
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string",
      "description": "Buyer that owns this delivery (exactly one). Required."
    },
    "name": {
      "type": "string",
      "description": "Operator-facing name for the delivery"
    },
    "vertical_id": {
      "type": "string",
      "description": "Optional vertical this delivery is scoped to"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "archived"
      ],
      "default": "draft",
      "description": "Lifecycle. Only 'active' deliveries can back a routing member."
    },
    "notes": {
      "type": "string",
      "description": "Free-form operator notes"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "buyer_id"
  ]
}
