{
  "name": "ImportTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template display name, usually the source"
    },
    "target": {
      "type": "string",
      "enum": [
        "lead",
        "bank"
      ],
      "default": "lead",
      "description": "Which entity this template imports into: Lead or BankTransaction"
    },
    "mapping": {
      "type": "string",
      "description": "JSON object mapping source CSV column -> target field name"
    },
    "migration_source_id": {
      "type": "string",
      "description": "Backup mirror only. The record id this row was copied from in the primary Legenex dashboard app. Used by the sync job to keep this app 1:1 with the primary. Not used by any dashboard logic."
    }
  },
  "required": [
    "name",
    "target"
  ]
}
